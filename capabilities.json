{
  "dataRoles": [
    {
      "displayName": "Row Category",
      "name": "rowCategory",
      "kind": "Grouping",
      "description": "What each row represents (e.g. Beat, BatteryCode)"
    },
    {
      "displayName": "Sparkline Category",
      "name": "sparklineCategory",
      "kind": "Grouping",
      "description": "Time axis for sparklines (e.g. Date)"
    },
    {
      "displayName": "Measures",
      "name": "measures",
      "kind": "Measure",
      "requiredTypes": [
        {
          "numeric": true
        }
      ],
      "description": "Numeric metric columns displayed in the table."
    },
    {
      "displayName": "Text Columns",
      "name": "textColumns",
      "kind": "GroupingOrMeasure",
      "description": "Text columns displayed after numeric measures."
    },
    {
      "displayName": "Sparkline Value",
      "name": "sparklineValue",
      "kind": "Measure",
      "requiredTypes": [
        {
          "numeric": true
        }
      ],
      "description": "Numeric measure for the sparkline trend chart."
    }
  ],
  "objects": {
    "tableSettings": {
      "properties": {
        "headerBackground": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Header Background"
        },
        "headerTextColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Header Text Color"
        },
        "rowColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Row Color"
        },
        "alternateRowColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Alternate Row Color"
        },
        "textColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Text Color"
        },
        "measureTextColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Measure Text Color"
        },
        "fontSize": {
          "type": {
            "numeric": true
          },
          "displayName": "Font Size"
        },
        "rowHeight": {
          "type": {
            "numeric": true
          },
          "displayName": "Row Height"
        },
        "showGridLines": {
          "type": {
            "bool": true
          },
          "displayName": "Show Grid Lines"
        }
      },
      "displayName": "Table Settings"
    },
    "sparklineSettings": {
      "properties": {
        "sparklineWidth": {
          "type": {
            "numeric": true
          },
          "displayName": "Sparkline Width"
        },
        "sparklineHeight": {
          "type": {
            "numeric": true
          },
          "displayName": "Sparkline Height"
        },
        "sparklineColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Sparkline Color"
        },
        "sparklineType": {
          "type": {
            "enumeration": [
              {
                "displayName": "Line",
                "value": "line"
              },
              {
                "displayName": "Area",
                "value": "area"
              },
              {
                "displayName": "Bar",
                "value": "bar"
              }
            ]
          },
          "displayName": "Sparkline Type"
        },
        "showDot": {
          "type": {
            "bool": true
          },
          "displayName": "Show Dot"
        },
        "dotColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Dot Color"
        },
        "lineWidth": {
          "type": {
            "numeric": true
          },
          "displayName": "Line Width"
        }
      },
      "displayName": "Sparkline Settings"
    },
    "columnWidthSettings": {
      "properties": {
        "categoryWidth": {
          "type": {
            "numeric": true
          },
          "displayName": "Category Width"
        },
        "measureWidth": {
          "type": {
            "numeric": true
          },
          "displayName": "Measure Width"
        },
        "textWidth": {
          "type": {
            "numeric": true
          },
          "displayName": "Text Width"
        },
        "sparklineWidth": {
          "type": {
            "numeric": true
          },
          "displayName": "Sparkline Width"
        }
      },
      "displayName": "Column Width Settings"
    },
    "sortSettings": {
      "properties": {
        "sortColumn": {
          "type": {
            "numeric": true
          },
          "displayName": "Sort Column"
        },
        "sortDirection": {
          "type": {
            "enumeration": [
              {
                "displayName": "Ascending",
                "value": "asc"
              },
              {
                "displayName": "Descending",
                "value": "desc"
              }
            ]
          },
          "displayName": "Sort Direction"
        }
      },
      "displayName": "Sort Settings"
    }
  },
  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "rowCategory"
              }
            },
            {
              "for": {
                "in": "sparklineCategory"
              }
            },
            {
              "for": {
                "in": "textColumns"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measures"
              }
            },
            {
              "bind": {
                "to": "textColumns"
              }
            },
            {
              "bind": {
                "to": "sparklineValue"
              }
            }
          ]
        }
      }
    }
  ],
  "privileges": [],
  "supportsHighlight": true,
  "supportsKeyboardFocus": true,
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsMultiVisualSelection": true,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    }
  }
}