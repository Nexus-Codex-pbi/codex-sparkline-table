  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "rowCategory"
              }
            },
            {
              "for": {
                "in": "sparklineCategory"
              }
            },
            {
              "for": {
                "in": "textColumns"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measures"
              }
            },
            {
              "bind": {
                "to": "textColumns"
              }
            },
            {
              "bind": {
                "to": "sparklineValue"
              }
            }
          ]
        }
      }
    }
  ],
  "privileges": [],
  "supportsHighlight": true,
  "supportsKeyboardFocus": true,
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsMultiVisualSelection": true,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    }
  },
  "suppressDefaultTitle": true
